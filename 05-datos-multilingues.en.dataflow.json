      { "id": "generation", "label": "Generation", "focus": ["loader", "data", "media"], "note": "Loaders validate schema and languages, then write the .js files the site consumes." },
      { "id": "consumption", "label": "Consumption", "focus": ["spa", "visitante"], "note": "The browser only reads static files: no queries, no database." }
    ]
  },
  "stages": [
    { "label": "Sources" },
    { "label": "Generation" },
    { "label": "Artifacts" },
    { "label": "Consumption" }
